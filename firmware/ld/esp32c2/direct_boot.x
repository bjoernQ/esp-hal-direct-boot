/* ESP32-C2 / ESP8684 */

DIRECT_BOOT_MAGIC_OFFSET = 0;
IROM_BASE = 0x42000000;
DROM_BASE = 0x3C000000;

/* IRAM 0x40380000 and DRAM 0x3FCA0000 address the same SRAM word */
IRAM_DRAM_OFFSET = 0x40380000 - 0x3FCA0000;

MEMORY
{
    ICACHE : ORIGIN = 0x4037C000, LENGTH = 16K
    IRAM : ORIGIN = 0x4037C000 + LENGTH(ICACHE), LENGTH = 186K
    DRAM : ORIGIN = 0x3FCA0000, LENGTH = 186K

    /* used by the ROM during boot, free afterwards */
    dram2_seg ( RW ) : ORIGIN = ORIGIN(DRAM) + LENGTH(DRAM), len = 0x3fcdeb70 - (ORIGIN(DRAM) + LENGTH(DRAM))

    IROM : ORIGIN = 0x42000000, LENGTH = 0x200000
    DROM : ORIGIN = 0x3C000000, LENGTH = 0x200000
}

REGION_ALIAS("ROTEXT", IROM);
REGION_ALIAS("RODATA", DROM);
REGION_ALIAS("RWTEXT", IRAM);
REGION_ALIAS("RWDATA", DRAM);

INCLUDE "direct_boot_riscv.x"
INCLUDE "direct_boot_riscv_no_rtc_fast.x"
INCLUDE "hal-defaults.x"
